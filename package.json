{
    "name": "lexicanter",
    "productName": "Lexicanter",
    "version": "2.3.3",
    "description": "A lexicon management tool for constructed languages.",
    "main": "src/index.js",
    "scripts": {
        "rust:build-dev": "cargo build --manifest-path=library/graphemy_ffi/Cargo.toml --release; cargo build --manifest-path=library/tadpole_ffi/Cargo.toml --release",
        "rust:build-all-targets": "bash scripts/cargobuild.bash",
        "precompile": "npm run rust:build-dev && sass -q src/sass/:src/styles && npm run format && vite build",
        "dev": "NODE_ENV=development concurrently \"npm run rust:build-dev\" \"sass -w -q src/sass/:src/styles\" \"npm run web:watch\" \"sleep 5 && npm run electron:start\"",
        "start": "npm run precompile && npm run electron:start",
        "web:watch": "vite --port 3000",
        "electron:start": "electron .",
        "build": "npm run rust:build-all-targets && bash scripts/build.bash",
        "build-mac": "npm run precompile && electron-builder --mac --x64 --arm64 --publish never",
        "build-win": "npm run precompile && electron-builder --win --x64 --ia32 --publish never",
        "build-linux": "npm run precompile && electron-builder --linux --x64 --arm64 --publish never",
        "publish": "npm run precompile && bash scripts/cargobuild.bash && bash scripts/publish.bash",
        "publish-only": "bash scripts/publish.bash",
        "check": "svelte-check --tsconfig ./tsconfig.json",
        "format": "prettier --write ."
    },
    "repository": "https://github.com/Saturnine-Softworks/Lexicanter",
    "build": {
        "buildDependenciesFromSource": true,
        "nodeGypRebuild": false,
        "npmRebuild": false,
        "publish": {
            "provider": "github",
            "releaseType": "release",
            "vPrefixedTagName": false
        },
        "appId": "com.lexicanter.app",
        "productName": "Lexicanter",
        "win": {
            "target": "nsis",
            "icon": "src/res/alembic.ico"
        },
        "mac": {
            "icon": "src/res/alembic.icns"
        },
        "linux": {
            "target": "AppImage",
            "icon": "src/res/alembic.png",
            "category": "Office"
        },
        "nsis": {
            "installerIcon": "src/res/alembic.ico",
            "installerHeaderIcon": "src/res/alembic.ico"
        },
        "files": [
            "./src/**/*",
            "./LICENSE",
            "./README.md"
        ],
        "extraResources": [
            {
                "from": "./library/graphemy_ffi/target/aarch64-apple-darwin/release/lib_graphemy_ffi.dylib",
                "to": "aarch64-apple-darwin/graphemy_ffi.dylib",
                "filter": [
                    "**/*"
                ]
            },
            {
                "from": "./library/graphemy_ffi/target/aarch64-unknown-linux-gnu/release/lib_graphemy_ffi.so",
                "to": "aarch64-unknown-linux-gnu/graphemy_ffi.so",
                "filter": [
                    "**/*"
                ]
            },
            {
                "from": "./library/graphemy_ffi/target/x86_64-apple-darwin/release/lib_graphemy_ffi.dylib",
                "to": "x86_64-apple-darwin/graphemy_ffi.dylib",
                "filter": [
                    "**/*"
                ]
            },
            {
                "from": "./library/graphemy_ffi/target/x86_64-unknown-linux-gnu/release/lib_graphemy_ffi.so",
                "to": "x86_64-unknown-linux-gnu/graphemy_ffi.so",
                "filter": [
                    "**/*"
                ]
            },
            {
                "from": "./library/graphemy_ffi/target/x86_64-pc-windows-gnu/release/_graphemy_ffi.dll",
                "to": "x86_64-pc-windows-gnu/graphemy_ffi.dll",
                "filter": [
                    "**/*"
                ]
            },
            {
                "from": "./library/graphemy_ffi/target/i686-pc-windows-gnu/release/_graphemy_ffi.dll",
                "to": "i686-pc-windows-gnu/graphemy_ffi.dll",
                "filter": [
                    "**/*"
                ]
            },
            {
                "from": "./library/tadpole_ffi/target/aarch64-apple-darwin/release/lib_tadpole_ffi.dylib",
                "to": "aarch64-apple-darwin/tadpole_ffi.dylib",
                "filter": [
                    "**/*"
                ]
            },
            {
                "from": "./library/tadpole_ffi/target/aarch64-unknown-linux-gnu/release/lib_tadpole_ffi.so",
                "to": "aarch64-unknown-linux-gnu/tadpole_ffi.so",
                "filter": [
                    "**/*"
                ]
            },
            {
                "from": "./library/tadpole_ffi/target/x86_64-apple-darwin/release/lib_tadpole_ffi.dylib",
                "to": "x86_64-apple-darwin/tadpole_ffi.dylib",
                "filter": [
                    "**/*"
                ]
            },
            {
                "from": "./library/tadpole_ffi/target/x86_64-unknown-linux-gnu/release/lib_tadpole_ffi.so",
                "to": "x86_64-unknown-linux-gnu/tadpole_ffi.so",
                "filter": [
                    "**/*"
                ]
            },
            {
                "from": "./library/tadpole_ffi/target/x86_64-pc-windows-gnu/release/_tadpole_ffi.dll",
                "to": "x86_64-pc-windows-gnu/tadpole_ffi.dll",
                "filter": [
                    "**/*"
                ]
            }
        ],
        "directories": {
            "output": "dist"
        }
    },
    "keywords": [],
    "author": {
        "name": "Ethan Ray"
    },
    "license": "GNU General Public License Version 3",
    "engine": {
        "node": ">=23.3.0"
    },
    "dependencies": {
        "@editorjs/editorjs": "2.31.7",
        "@editorjs/header": "2.8.9",
        "@editorjs/list": "2.0.9",
        "@editorjs/paragraph": "2.11.7",
        "@editorjs/table": "2.4.6",
        "@editorjs/text-variant-tune": "1.0.3",
        "@editorjs/underline": "1.2.1",
        "@electron/remote": "2.1.3",
        "@types/marked": "6.0.0",
        "@types/node": "26.6.5",
        "@types/wicg-file-system-access": "2023.10.7",
        "csv-parser": "3.2.1",
        "editorjs-text-alignment-blocktune": "1.0.3",
        "editorjs-toggle-block": "0.3.16",
        "electron-build": "0.0.3",
        "electron-updater": "6.8.11",
        "koffi": "=2.16.3",
        "lz-string": "^1.5.0",
        "marked": "18.1.1",
        "moo": "0.5.3",
        "nearley": "2.20.1",
        "node-fetch": "3.3.2",
        "sass": "1.106.1",
        "semver": "7.8.5",
        "vex-js": "4.1.0"
    },
    "devDependencies": {
        "@sveltejs/vite-plugin-svelte": "=6.2.4",
        "@tsconfig/svelte": "5.0.8",
        "@types/moo": "0.5.10",
        "@types/nearley": "2.11.5",
        "dotenv": "18.0.9",
        "electron": "45.0.0",
        "electron-builder": "26.18.0",
        "electron-notarize": "^1.2.2",
        "globals": "17.13.0",
        "mdsvex": "0.12.8",
        "prettier": "3.9.10",
        "svelte": "5.57.2",
        "svelte-check": "4.7.7",
        "svelte-preprocess": "6.0.5",
        "tslab": "^1.0.22",
        "tslib": "2.8.1",
        "typescript": "=6.0.3",
        "vite": "7.3.7",
        "vite-plugin-electron-renderer": "=0.14.7"
    }
}
